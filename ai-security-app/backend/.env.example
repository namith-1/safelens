PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ai_security_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Nodemailer (Gmail example) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="AI Security <no-reply@aisecurity.com>"

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ─── URLs ─────────────────────────────────────────────────────────────────────
# LOCAL:
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
APP_URL=http://localhost:5000

# CLOUD (uncomment and fill when deploying):
# FRONTEND_URL=https://safelens-three.vercel.app
# FRONTEND_URLS=https://safelens-three.vercel.app,https://www.safelens.com
# APP_URL=https://safelens-backend.onrender.com

# ─── Groq AI (free tier — no billing required) ───────────────────────────────
# Get your free key: https://console.groq.com/keys
# Limits: 30 req/min · 6 000 req/day · 500 K tokens/day (llama-3.3-70b)
GROQ_API_KEY=your_groq_api_key_here
